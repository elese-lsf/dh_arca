   "source": [
    "%%sql\n",
    "SELECT SUM(v.unidades * v.precio_unitario * (1 - v.descuento_pct)) AS facturacion_correcta\n",
    "FROM ventas v\n",
    "JOIN clientes c ON c.id_cliente = v.id_cliente  -- ✅ cada venta con su cliente\n",
    "WHERE v.estado = 'completada'"
   ]
